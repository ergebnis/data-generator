parameters:
	ignoreErrors:
		-
			message: '#^Property Ergebnis\\DataGenerator\\OptionalValueGenerator\:\:\$values \(list\<string\>\) does not accept non\-empty\-array\<int\<0, max\>\|string, string\>\.$#'
			identifier: assign.propertyType
			count: 1
			path: src/OptionalValueGenerator.php

		-
			message: '#^Property Ergebnis\\DataGenerator\\SequentialValueGenerator\:\:\$generators \(list\<Ergebnis\\DataGenerator\\StringGenerator\>\) does not accept non\-empty\-array\<int\<0, max\>\|string, Ergebnis\\DataGenerator\\StringGenerator\>\.$#'
			identifier: assign.propertyType
			count: 1
			path: src/SequentialValueGenerator.php

		-
			message: '#^Property Ergebnis\\DataGenerator\\ValueGenerator\:\:\$values \(list\<string\>\) does not accept non\-empty\-array\<int\<0, max\>\|string, string\>\.$#'
			identifier: assign.propertyType
			count: 1
			path: src/ValueGenerator.php

		-
			message: '#^Only iterables can be unpacked, array\|string given in argument \#1\.$#'
			identifier: argument.unpackNonIterable
			count: 1
			path: test/Unit/ConcatenatingValueGeneratorTest.php

		-
			message: '#^Parameter \#1 \.\.\.\$values of class Ergebnis\\DataGenerator\\ValueGenerator constructor expects string, mixed given\.$#'
			identifier: argument.type
			count: 1
			path: test/Unit/ConcatenatingValueGeneratorTest.php

		-
			message: '#^Only iterables can be unpacked, array\|string given in argument \#1\.$#'
			identifier: argument.unpackNonIterable
			count: 1
			path: test/Unit/OptionalValueGeneratorTest.php

		-
			message: '#^Parameter \#1 \$expected of static method PHPUnit\\Framework\\Assert\:\:assertSame\(\) contains unresolvable type\.$#'
			identifier: argument.unresolvableType
			count: 1
			path: test/Unit/OptionalValueGeneratorTest.php

		-
			message: '#^Parameter \#1 \.\.\.\$values of class Ergebnis\\DataGenerator\\OptionalValueGenerator constructor expects string, mixed given\.$#'
			identifier: argument.type
			count: 1
			path: test/Unit/OptionalValueGeneratorTest.php

		-
			message: '#^Parameter \#2 \.\.\.\$arrays of function array_merge expects array, array\|string given\.$#'
			identifier: argument.type
			count: 1
			path: test/Unit/OptionalValueGeneratorTest.php

		-
			message: '#^Only iterables can be unpacked, array\|string given in argument \#1\.$#'
			identifier: argument.unpackNonIterable
			count: 1
			path: test/Unit/SequentialValueGeneratorTest.php

		-
			message: '#^Parameter \#1 \.\.\.\$values of class Ergebnis\\DataGenerator\\ValueGenerator constructor expects string, mixed given\.$#'
			identifier: argument.type
			count: 1
			path: test/Unit/SequentialValueGeneratorTest.php

		-
			message: '#^Only iterables can be unpacked, array\|string given in argument \#1\.$#'
			identifier: argument.unpackNonIterable
			count: 1
			path: test/Unit/ValueGeneratorTest.php

		-
			message: '#^Parameter \#1 \.\.\.\$values of class Ergebnis\\DataGenerator\\ValueGenerator constructor expects string, mixed given\.$#'
			identifier: argument.type
			count: 1
			path: test/Unit/ValueGeneratorTest.php

